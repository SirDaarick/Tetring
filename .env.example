# Configuración de base de datos
# SQLite para desarrollo (por defecto), PostgreSQL para producción
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Clave secreta para firmar JWT (mínimo 32 caracteres en producción)
SECRET_KEY=cambiar-por-una-clave-segura-de-32-caracteres-min

# Credenciales de OAuth 2.0 de Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL del microservicio SAES (Node.js en saes-api/)
SAES_API_URL=http://localhost:5000

# Clave de cifrado AES-256-GCM para credenciales SAES.
# Debe ser una cadena hexadecimal de 64 caracteres (32 bytes) o una cadena de 32 bytes.
ENCRYPTION_KEY=

# Vigencia de tokens JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (opcional en esta fase; se usa para rate limiting y polling de cupos)
REDIS_URL=redis://localhost:6379
